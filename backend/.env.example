# AyuVitamin Backend Configuration
# Local only; Render sets PORT automatically.
PORT=3001

# MongoDB Atlas Database URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Public URL of the deployed Render frontend, used for browser CORS.
FRONTEND_URL=https://your-render-frontend.onrender.com

# Optional: Google Places key, if live Places integration is implemented/configured.
# GOOGLE_PLACES_API_KEY=your_key_here
